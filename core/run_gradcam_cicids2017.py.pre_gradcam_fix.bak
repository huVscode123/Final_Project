# -*- coding: utf-8 -*-
"""Run Grad-CAM / Grad-CAM++ / Score-CAM on the 8 Chapter 4.6 cases.

Run this script from the project root or call it by its path:

    python core/run_gradcam_cicids2017.py \
      --input data/cicids2017/Monday-WorkingHours.pcap_ISCX.csv \
             data/cicids2017/Friday-WorkingHours-Afternoon-DDos.pcap_ISCX.csv \
      --variants gradcam gradcam++ scorecam \
      --output output/gradcam_cicids2017_compare

The script reuses:
- the exact 8 CSV row indices documented in Chapter 4.6;
- the trained CNN-VAE checkpoint and its threshold;
- the matching training-time RobustScaler + feature_columns pickle;
- the CNN-VAE full anomaly score (reconstruction MSE + weighted KL).

It does not train a model or fit a new scaler.
"""
from __future__ import annotations

import argparse
import itertools
import json
import math
import pickle
